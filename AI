-- Enemy AI with Advanced Logic and Structured Design

-- References to enemy model and Roblox services
local enemy = script.Parent
local humanoid = enemy:WaitForChild("Humanoid")
local rootPart = enemy:WaitForChild("HumanoidRootPart")
local players = game:GetService("Players")
local debris = game:GetService("Debris")

-- Attack Constants
local ATTACK_CONSTANTS = {
	Damage = {
		LongRange = 25,
		ShortRange = 5,
	},
	Range = {
		Long = 100,
		Mid = 70,
		Short = 10,
	},
	Cooldowns = {
		Shoot = 2,
		Melee = 0.5,
	},
	SprintDuration = 2,
	ProjectileSpeed = 50,
	Delay = {
		Min = 0.5,
		Max = 1.5,
	}
}

-- Beam Counters using metatables for dynamic management
local beamCounters = {
	Red = 0,
	Blue = 0,
	Yellow = 0,
}

setmetatable(beamCounters, {
	__index = function(_, key)
		return rawget(_, key) or 0
	end,
})

-- Helper Functions

--- Displays a red "!" above the enemy's head as a warning.
-- Creates a BillboardGui with a red exclamation mark, attaches it to the enemy, and removes it after a short duration.
local function showAttackWarning()
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 50, 0, 50)
	billboard.Adornee = rootPart
	billboard.Parent = enemy
	billboard.StudsOffset = Vector3.new(0, 5, 0)

	local label = Instance.new("TextLabel")
	label.Text = "!"
	label.Font = Enum.Font.ArialBold
	label.TextColor3 = Color3.new(1, 0, 0) -- Red color
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.TextScaled = true
	label.Parent = billboard

	task.wait(1)
	billboard:Destroy()
end

--- Creates a telegraph sphere at the target position before an attack.
-- Spawns a purple transparent, collisionless sphere as a visual warning for the attack.
-- @param targetPosition The position where the sphere will appear.
local function showTelegraphEffect(targetPosition)
	local telegraph = Instance.new("Part")
	telegraph.Size = Vector3.new(5, 5, 5)
	telegraph.Shape = Enum.PartType.Ball
	telegraph.BrickColor = BrickColor.new("Bright violet")
	telegraph.Material = Enum.Material.Neon
	telegraph.Transparency = 0.9
	telegraph.CanCollide = false
	telegraph.Anchored = true
	telegraph.CFrame = CFrame.new(targetPosition)
	telegraph.Parent = workspace

	debris:AddItem(telegraph, 1)
end

--- Finds the closest player to the enemy.
-- Iterates through all players in the game to calculate their distance from the enemy. Returns the nearest player and the corresponding distance by comparing each player's distance.
-- @return closestPlayer The nearest player.
-- @return distance The distance to the nearest player.
local function getClosestPlayer()
	local closestPlayer, closestDistance = nil, ATTACK_CONSTANTS.Range.Long + 1

	for _, player in pairs(players:GetPlayers()) do
		local character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") then
			local distance = (rootPart.Position - character.HumanoidRootPart.Position).Magnitude
			if distance < closestDistance then
				closestDistance = distance
				closestPlayer = player
			end
		end
	end

	return closestPlayer, closestDistance
end

--- Inflicts damage to a player.
-- Reduces the player's humanoid health by the specified damage value if the humanoid exists.
-- @param player The player to damage.
-- @param damage The amount of damage to deal.
local function dealDamage(player, damage)
	local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
	if humanoid then
		humanoid:TakeDamage(damage)
	end
end

--- Shoots a projectile towards a target.
-- Creates a projectile part, applies velocity towards the target, and checks for collisions to deal damage upon contact. The projectile is automatically cleaned up after 5 seconds.
-- @param targetPosition The position to aim at.
-- @param color The projectile color.
-- @param damage The damage the projectile inflicts.
-- @param sizeMultiplier The size multiplier for the projectile.
local function shootProjectile(targetPosition, color, damage, sizeMultiplier)
	local projectile = Instance.new("Part")
	projectile.Size = Vector3.new(2 * sizeMultiplier, 2 * sizeMultiplier, 2 * sizeMultiplier)
	projectile.Shape = Enum.PartType.Ball
	projectile.BrickColor = BrickColor.new(color)
	projectile.Material = Enum.Material.Neon
	projectile.CanCollide = false
	projectile.CFrame = rootPart.CFrame
	projectile.Parent = workspace

	local velocity = Instance.new("BodyVelocity")
	velocity.Velocity = (targetPosition - rootPart.Position).Unit * ATTACK_CONSTANTS.ProjectileSpeed
	velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	velocity.Parent = projectile

	projectile.Touched:Connect(function(hit)
		local player = players:GetPlayerFromCharacter(hit.Parent)
		if player and hit.Parent ~= enemy then
			dealDamage(player, damage)
			projectile:Destroy()
		end
	end)

	debris:AddItem(projectile, 5)
end

--- Makes the enemy sprint towards a player.
-- Temporarily doubles the enemy's movement speed and directs it towards the target position. Resets the speed after the sprint duration elapses.
-- @param targetPosition The position to sprint to.
local function sprintTowardsPlayer(targetPosition)
	local originalSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = originalSpeed * 2
	humanoid:MoveTo(targetPosition)
	task.wait(ATTACK_CONSTANTS.SprintDuration)
	humanoid.WalkSpeed = originalSpeed
end

--- Randomizes attack delays.
-- Generates a random delay time between the minimum and maximum delay constants.
-- @return A random delay time.
local function randomizeAttackDelay()
	return math.random(ATTACK_CONSTANTS.Delay.Min, ATTACK_CONSTANTS.Delay.Max)
end

-- Attack Functions

--- Performs a red beam attack.
-- Tracks the number of red beams fired using a counter. When the counter reaches 5, a blue beam attack is triggered, and the counter resets. This ensures a predictable yet dynamic attack sequence.
-- @param targetPosition The position to aim the attack.
local function performRedBeamAttack(targetPosition)
	task.wait(randomizeAttackDelay())
	showAttackWarning()
	showTelegraphEffect(targetPosition)
	if beamCounters.Red < 5 then
		shootProjectile(targetPosition, "Bright red", ATTACK_CONSTANTS.Damage.LongRange, 1)
		beamCounters.Red += 1
	elseif beamCounters.Red == 5 then
		shootProjectile(targetPosition, "Bright blue", ATTACK_CONSTANTS.Damage.LongRange * 3, 3)
		beamCounters.Red = 0
		beamCounters.Blue += 1
	end
end

--- Performs a giant yellow beam attack.
-- The yellow beam is triggered when the blue beam counter reaches 2. This attack resets the blue counter and increments the yellow counter, signifying a complete attack cycle.
-- @param targetPosition The position to aim the attack.
local function performGiantYellowBeamAttack(targetPosition)
	task.wait(randomizeAttackDelay())
	showAttackWarning()
	showTelegraphEffect(targetPosition)
	if beamCounters.Blue == 2 then
		shootProjectile(targetPosition, "Bright yellow", ATTACK_CONSTANTS.Damage.LongRange * 5, 5)
		beamCounters.Blue = 0
		beamCounters.Yellow += 1
		sprintTowardsPlayer(targetPosition)
	end
end

-- Main Logic Loop
while task.wait(0.1) do
	local closestPlayer, distance = getClosestPlayer()

	if closestPlayer then
		local targetPosition = closestPlayer.Character.HumanoidRootPart.Position

		if distance <= ATTACK_CONSTANTS.Range.Short then
			showAttackWarning()
			showTelegraphEffect(targetPosition)
			dealDamage(closestPlayer, ATTACK_CONSTANTS.Damage.ShortRange)
		elseif distance <= ATTACK_CONSTANTS.Range.Mid then
			performRedBeamAttack(targetPosition)
			performGiantYellowBeamAttack(targetPosition)
		end

		if distance <= ATTACK_CONSTANTS.Range.Long then
			sprintTowardsPlayer(targetPosition)
		end
	end
end

